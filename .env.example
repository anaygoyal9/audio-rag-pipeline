# Copy to .env and adjust.
ENVIRONMENT=dev                      # anything other than "dev" refuses to start with the default JWT secret
JWT_SECRET=change-me-in-dev-only     # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=60
BCRYPT_ROUNDS=12

MONGO_URI=mongodb://localhost:27017
MONGO_DB=audio_rag
REDIS_URL=redis://localhost:6379/0   # leave empty to fall back to an in-process cache

# Vector store: Pinecone serverless (free key at https://app.pinecone.io).
# VECTOR_BACKEND=memory runs a brute-force in-process index instead (offline dev; nothing persisted).
VECTOR_BACKEND=pinecone
PINECONE_API_KEY=                   # get a free key at https://app.pinecone.io
PINECONE_INDEX=audio-rag            # embedder name is appended; the index is created on first start
PINECONE_NAMESPACE=songs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# pinecone = hosted multilingual-e5-large via Pinecone Inference (1024-d, no local model)
# hash     = offline, deterministic, lexical only (pair with VECTOR_BACKEND=memory)
EMBEDDING_BACKEND=pinecone
EMBEDDING_CACHE_TTL=86400

# Optional LLM query understanding: none | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=https://api.openai.com/v1   # only for provider=openai (or any OpenAI-compatible server)

AUDIO_DIR=./data/audio
MAX_UPLOAD_MB=50
STREAM_CHUNK_SIZE=65536

RATE_LIMIT_REQUESTS=120              # per window, per client
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10          # login/register brute-force guard
TRUST_PROXY_HEADERS=false            # true only behind a proxy you control (uses X-Forwarded-For)

CORS_ORIGINS=http://localhost:5173
